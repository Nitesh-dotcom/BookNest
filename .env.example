# BookNest Environment Configuration Example
# Copy this file to .env or configure your system environment variables accordingly.

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=booknest_db
DB_USERNAME=root
DB_PASSWORD=

# JDBC URL constructed from above:
# jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Security / JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080

# Default Seed Administrator
ADMIN_NAME=BookNest Administrator
ADMIN_EMAIL=admin@booknest.com
ADMIN_PASSWORD=Admin@123
